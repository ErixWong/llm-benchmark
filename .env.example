# ===== 必填：API 配置 =====
API_BASE_URL=https://api.example.com/v1
API_KEY=your-api-key-here
API_MODEL=gpt-3.5-turbo

# 请求 User-Agent（代码默认 llm-benchmark/1.0.0）
USER_AGENT=llm-benchmark/1.0.0

# ===== 测试参数 =====
# 并发数
DEFAULT_CONCURRENCY=4
# 采样轮数：总请求数 = 并发数 × 轮数
ROUNDS=5
# 单次请求超时，注意单位是毫秒
DEFAULT_TIMEOUT=30000
# 单请求最大输出 token（max_tokens）
# 推理模型请给足余量，过小会导致输出全被思考占满、没有可见答案
MAX_OUTPUT_TOKENS=30000
# 并发模式：pipeline（完成一个补一个，默认）| batch（整批发、整批等）
CONCURRENCY_MODE=pipeline
# 最大重试次数；0 = 关闭重试（干净测量）
RETRY=3

# ===== 缓存命中探针 =====
# 是否启用冷/热缓存探针
CACHE_PROBE=false
# auto（默认）| prefix（仅 probe）| model | none
WARMUP_MODE=auto
# 每个单元素材的目标前缀 token 数
PREFIX_TOKENS=4096
# 素材文件起点轮转种子（保证可复现）
CACHE_SEED=42

# ===== 大上下文样本 =====
# 每次请求随机抽取的样本数；0 = 使用内置简单 prompt，不读取文件
SAMPLE_COUNT=0
# 自定义样本文件名匹配规则（逗号分隔的正则，匹配任一即入选；设置后覆盖默认规则）
# 默认规则：含 -8k/-16k，或以 sample-/novel-/tech-news-/conversation-/code-samples-/multimodal- 开头
# SAMPLE_FILE_PATTERNS=^sample-,^novel-

# ===== 透传服务端特有参数（JSON 对象字符串）=====
# 保留键 model / messages / max_tokens / stream 会被忽略并告警
# 关闭 GLM / Qwen 思考模式：
# EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# 目标端点不接受 stream_options 时关闭 usage 请求：
# EXTRA_BODY={"stream_options":{"include_usage":false}}

# ===== 报告 =====
REPORT_OUTPUT_DIR=./results
# 报告标题，默认使用 API_MODEL
REPORT_TITLE=My Custom Report Title
# 是否把模型输出全文写入 JSON 报告（默认不写：体积大且含模型完整输出）
# REPORT_INCLUDE_TEXT=true

# ===== 调试 =====
# 置任意值时打印流式解析错误等调试信息
# DEBUG=1
