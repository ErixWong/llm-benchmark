{
  "api": {
    "baseUrl": "${API_BASE_URL}",
    "apiKey": "${API_KEY}",
    "model": "${API_MODEL}",
    "timeout": 90000,
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "benchmark": {
    "concurrency": 4,
    "rounds": 5,
    "sampleCount": 0,
    "maxOutputTokens": 30000,
    "concurrencyMode": "pipeline",
    "timeout": 90000,
    "warmupRequests": 1
  },
  "report": {
    "outputDir": "./results",
    "formats": ["json", "html", "markdown"],
    "includeRawData": true,
    "title": "${REPORT_TITLE}"
  }
}
